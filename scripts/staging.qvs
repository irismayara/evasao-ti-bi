STG_IES:
LOAD DISTINCT
    CO_UF_IES,
    CO_MUNICIPIO_IES,
    NO_UF_IES,
    NO_MUNICIPIO_IES,
    IN_CAPITAL_IES,
    CO_REGIAO_IES,
    NO_REGIAO_IES,
    NO_MESORREGIAO_IES,
    NO_MICRORREGIAO_IES,
    CO_IES,
    NO_IES,
    SG_IES
FROM [lib://ies_dados_transf.xlsx]
(ooxml, embedded labels, table is Sheet1);

LEFT JOIN(STG_CURSOS)
LOAD 
	CO_IES,
    CO_UF_IES,
    CO_MUNICIPIO_IES
RESIDENT STG_IES;
