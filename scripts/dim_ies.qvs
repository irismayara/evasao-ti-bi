DIM_IES:
LOAD DISTINCT
	AutoNumber(CO_IES)			AS COD_IES,
    IF(TP_ORGANIZACAO_ACADEMICA = 1, 'UNIVERSIDADE',
    	IF(TP_ORGANIZACAO_ACADEMICA = 2, 'CENTRO UNIVERSITÁRIO',
        	IF(TP_ORGANIZACAO_ACADEMICA = 3, 'FACULDADE',
            	IF(TP_ORGANIZACAO_ACADEMICA = 4, 'INSTITUTO FEDERAL DE EDUCAÇÃO, CIÊNCIA E TECNOLOGIA', 
                	IF(TP_ORGANIZACAO_ACADEMICA = 4, 'CENTRO FEDERAL DE EDUCAÇÃO TECNOLÓGICA', NULL()
    )))))    					AS TIP_ORGANIZACAO_ACADEMICA,
    IF(TP_REDE = 1, 'PÚBLICA',
    	IF(TP_REDE = 2, 'PRIVADA', NULL()
       )) 						AS TIP_REDE
RESIDENT STG_CURSOS;
    
LEFT JOIN(DIM_IES)
LOAD 
	AutoNumber(CO_IES)			AS COD_IES,
    UPPER(NO_IES)				AS NOM_IES,
    UPPER(SG_IES)				AS SIG_IES
RESIDENT STG_IES;
