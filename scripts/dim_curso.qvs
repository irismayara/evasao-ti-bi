MAP_CURSO:
MAPPING LOAD
    'SISTEMA DE INFORMAÇÃO' 	AS Origem,
    'SISTEMAS DE INFORMAÇÃO' 	AS Corrigido
AUTOGENERATE 1;	

DIM_CURSO:
LOAD DISTINCT 
	AutoNumber(CO_CURSO)							AS COD_CURSO,
    UPPER(
    	ApplyMap('MAP_CURSO', NO_CURSO, NO_CURSO)) 	AS NOM_CURSO,
    UPPER(NO_CINE_AREA_ESPECIFICA)					AS NOM_CINE_AREA_ESPECIFICA,
    UPPER(NO_CINE_AREA_DETALHADA)					AS NOM_CINE_AREA_DETALHADA,
    IF(TP_GRAU_ACADEMICO = 1, 'BACHARELADO',
    	IF(TP_GRAU_ACADEMICO = 2, 'LICENCIATURA',
        	IF(TP_GRAU_ACADEMICO = 3, 'TECNÓLOGO',
            	IF(TP_GRAU_ACADEMICO = 4, 'BACHARELADO E LICENCIATURA', NULL()
    ))))    										AS TIP_GRAU_ACADEMICO,
    IF(TP_MODALIDADE_ENSINO = 1, 'PRESENCIAL',
    	IF(TP_MODALIDADE_ENSINO = 2, 'EAD', NULL()
    ))												AS TIP_MODALIDADE_ENSINO
RESIDENT STG_CURSOS;  
