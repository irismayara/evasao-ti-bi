DIM_LOCALIDADE:
LOAD DISTINCT
	  AutoNumber(CO_UF_IES & CO_MUNICIPIO_IES)	AS COD_LOCALIDADE,
    UPPER(NO_UF_IES)							AS NOM_UF,
    UPPER(NO_MUNICIPIO_IES)						AS NOM_MUNICIPIO,
    UPPER(NO_REGIAO_IES)						AS NOM_REGIAO,
    UPPER(NO_MESORREGIAO_IES)					AS NOM_MESORREGIAO,
    UPPER(NO_MICRORREGIAO_IES)					AS NOM_MICRORREGIAO_IES,
    IN_CAPITAL_IES								AS IND_CAPITAL
RESIDENT STG_IES;
